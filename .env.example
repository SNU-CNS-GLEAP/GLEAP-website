DATABASE_URL=
# 마이그레이션(drizzle-kit)처럼 pgbouncer 풀링 없는 직접 연결이 필요할 때만 사용
DATABASE_URL_UNPOOLED=
BLOB_READ_WRITE_TOKEN=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Gmail SMTP 공식 발송 설정 (snucnsgleap@gmail.com)
GMAIL_SMTP_USER=snucnsgleap@gmail.com
GMAIL_SMTP_APP_PASSWORD=
EMAIL_FROM=GLEAP <snucnsgleap@gmail.com>

# Resend API 설정 (대체 메일 발송용, 선택 사항)
RESEND_API_KEY=

# 소식 글 작성/수정 시 본문을 이메일로 자체 백업 발송할지 여부. 비워두면 켜짐(기본값) —
# 끄고 싶으면 false로 설정. 받는 주소를 비우면 GMAIL_SMTP_USER 자기 자신에게 보냄.
POST_BACKUP_EMAIL_ENABLED=
POST_BACKUP_EMAIL_TO=

########
# 웹사이트를 local에서 돌릴 때, 아래의 환경변수들을 설정해주어야 합니다.
# 이 파일을 복사하여, .env.local 파일을 만든 뒤, 값을 입력하고,
# 현재 주석 처리된 내용을 지워주세요.
# .gitignore에 작성된 대로, 절대로 .env.local 파일을 깃허브에 올리지 않도록 주의하세요.
